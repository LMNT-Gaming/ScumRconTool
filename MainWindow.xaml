<Window x:Class="ScumRconTool.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:services="clr-namespace:ScumRconTool.Services"
        xmlns:viewModels="clr-namespace:ScumRconTool.ViewModels"
        xmlns:views="clr-namespace:ScumRconTool.Views"
        Title="Red Raven Rcon Tool" Height="900" Width="1380" MinHeight="760" MinWidth="1180">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#101016"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="Assets/logo.png"
                           Height="118"
                           Stretch="Uniform"
                           Margin="0,0,0,14" />
                    <TextBlock Text="Red Raven"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Rcon Tool"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,18" />

                    <Border Background="#17171F"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Version"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,10" />
                            <Button Content="{Binding UpdateButtonText}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="{Binding Texts[OpenDownload]}"
                                    Command="{Binding OpenUpdateDownloadCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="{Binding Texts[SwitchLanguage]}"
                                    Command="{Binding SwitchLanguageCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="{Binding Texts[GgconDocs]}"
                                    Command="{Binding OpenGgconDocsCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding Texts[Status]}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Border Background="#17171F"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="RCON" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding RconStatusText}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Texts[CurrentPlayers]}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding CurrentPlayersStatus}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Discord" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding DiscordStatus}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Texts[AutoMessages]}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding AutoMessagesRunning}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Texts[SettingRandomizer]}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SettingRandomizerRunning}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding Texts[ScriptZone]}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding ScriptEngineRunning}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <TabControl x:Name="MainTabs" Background="Transparent">
                <TabItem Header="{Binding Texts[Dashboard]}">
                    <TabControl x:Name="DashboardTabs" Background="Transparent" SelectionChanged="DashboardTabs_SelectionChanged">
                        <TabItem Header="{Binding Texts[Overview]}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Red Raven Rcon Tool" FontSize="34" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Texts[Dashboard]}" Foreground="{StaticResource MutedTextBrush}" FontSize="18" Margin="0,0,0,18" />
                            <WrapPanel>
                                <Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="RCON" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RconStatusText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding RconStatusDescription}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="Discord" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DiscordStatus}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Bridge + Embeds" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts[ChatCommands]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ChatCommandsRunning}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Texts[IngameChatCommandsShort]}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts[JoinCommands]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding JoinCommandsRunning}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Texts[LoginDelayCommandsShort]}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
<Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts[WeeklyTasks]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WeeklyTasksRunning}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding WeeklyTaskStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts[AutoMessages]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AutoMessagesRunning}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding AutoMessageStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Width="260">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts[Scripts]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Scripts.Count}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Texts[JsonEventFiles]}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="Engine" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ScriptEngineRunning}" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Texts[ScriptStatus]}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding ScriptRuntimeSummary}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Texts[ScriptStatusHint]}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding ScriptRuntimeStatuses}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,10,10" Padding="12" CornerRadius="10" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" MinWidth="220" Background="#1E1E26">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E1E26" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Initiated">
                                                                    <Setter Property="Background" Value="#0E2A44" />
                                                                    <Setter Property="BorderBrush" Value="#2D9CDB" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Live">
                                                                    <Setter Property="Background" Value="#12351E" />
                                                                    <Setter Property="BorderBrush" Value="#27AE60" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="CleanupPending">
                                                                    <Setter Property="Background" Value="#3A2A10" />
                                                                    <Setter Property="BorderBrush" Value="#F2994A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Cooldown">
                                                                    <Setter Property="Background" Value="#27272F" />
                                                                    <Setter Property="BorderBrush" Value="#777777" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding StateLabel}" FontWeight="Bold" />
                                                            <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding Mode}" Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Group, StringFormat={}Gruppe: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding CooldownUntil, StringFormat={}Cooldown bis: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding LastAction, StringFormat={}Live: {0}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding LastLootSummary, StringFormat={}Loot: {0}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LastRawCommand, StringFormat={}Raw: {0}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" />
                                                        <Button Content="{Binding DataContext.Texts[ManualStartEvent], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Command="{Binding DataContext.ManualStartEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanManualStart}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,10,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Texts[LastActions]}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{Binding Texts[OpenFolder]}" Command="{Binding OpenLogFolderCommand}" />
                                            <Button Content="{Binding Texts[Clear]}" Command="{Binding ClearLogCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding LogLines}" Height="420" Background="#101016" Foreground="{StaticResource AppTextBrush}" BorderBrush="{StaticResource AppBorderBrush}" />
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{Binding Texts[CurrentPlayers]}" Tag="Players">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Texts[LivePlayerMap]}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DashboardPlayerStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding DashboardEnvironmentStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding Texts[RefreshNow]}" Command="{Binding RefreshDashboardPlayersCommand}" Margin="10,0,16,0" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Texts[ServerTime]}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding DashboardServerTime, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="76" MaxLength="5" FontFamily="Consolas" HorizontalContentAlignment="Center"
                                                     ToolTip="HH:mm" />
                                            <Button Content="{Binding Texts[Apply]}" Command="{Binding SetDashboardServerTimeCommand}" Margin="4,0,16,0" />
                                            <TextBlock Text="{Binding Texts[Weather]}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    Value="{Binding DashboardWeatherPercent}" Width="150" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DashboardWeatherPercent, StringFormat={}{0:0}%}" Width="45" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Button Content="{Binding Texts[Apply]}" Command="{Binding SetDashboardWeatherCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Texts[DashboardMessage]}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DashboardMessageStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding DashboardMessageText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" MaxLength="500" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="2" Content="{Binding Texts[GlobalSideChat]}" Command="{Binding SendDashboardGlobalChatCommand}" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Content="{Binding Texts[WhisperSelected]}" Command="{Binding SendDashboardWhisperCommand}" Margin="0,0,6,0"
                                                ToolTip="{Binding SelectedDashboardPlayer.DisplayName}" />
                                        <Button Grid.Column="4" Content="{Binding Texts[SendAnnouncement]}" Command="{Binding SendDashboardAnnouncementCommand}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="340" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Texts[OnlinePlayers]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <ListBox Grid.Row="1" ItemsSource="{Binding DashboardPlayers}" SelectedItem="{Binding SelectedDashboardPlayer}"
                                                     Background="#101016" BorderBrush="{StaticResource AppBorderBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryLine}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Coordinates}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding PingText, StringFormat=Ping: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                <TextBlock Text="{Binding HealthText, StringFormat={}  ·  Health: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Border Grid.Row="2" Background="#181820" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                                                    DataContext="{Binding SelectedDashboardPlayer}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="16" />
                                                    <TextBlock Text="{Binding Coordinates}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Fame, StringFormat=Fame: {0:0}}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding AccountBalance, StringFormat=Balance: {0:0}}" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8">
                                        <Viewbox Stretch="Uniform">
                                            <Canvas Width="1516" Height="1518" Background="#0D0D12">
                                                <Image Source="scum_kartographer/assets/scum_map.jpg" Width="1516" Height="1518" Stretch="Fill" />
                                                <ItemsControl ItemsSource="{Binding DashboardPlayers}" Width="1516" Height="1518">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding MapX}" />
                                                            <Setter Property="Canvas.Top" Value="{Binding MapY}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="13" Height="13" Fill="#D3152A" Stroke="White" StrokeThickness="2"
                                                                     Margin="-6.5,-6.5,0,0" ToolTip="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ContentControl Content="{Binding SelectedDashboardPlayer}"
                                                                Canvas.Left="{Binding SelectedDashboardPlayer.MapX}"
                                                                Canvas.Top="{Binding SelectedDashboardPlayer.MapY}">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="-11,-11,0,0">
                                                                <Ellipse Width="22" Height="22" Fill="#F3C95B" Stroke="#D3152A" StrokeThickness="3" />
                                                                <TextBlock Text="{Binding DisplayName}" Margin="26,-2,0,0" Padding="5,2"
                                                                           Background="#DD101016" Foreground="White" FontWeight="Bold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="{Binding Texts[RconConsole]}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Texts[RconConsole]}" FontSize="28" FontWeight="Bold" />
                                <TextBlock Text="{Binding Texts[RconConsoleDescription]}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Texts[Connect]}" Command="{Binding ConnectRconCommand}" />
                                    <Button Content="{Binding Texts[Send]}" Command="{Binding SendRconCommand}" />
                                </StackPanel>
                                <TextBlock Text="Command" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Text="{Binding RconCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <TextBox Text="{Binding LastRconResponse}" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding Texts[DiscordBridge]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts[DiscordBridge]}" FontSize="34" FontWeight="Bold" Margin="0,0,0,18" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Bot" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Texts[DiscordBotDescription]}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Texts[StartDiscord]}" Command="{Binding StartDiscordCommand}" />
                                        <Button Content="{Binding Texts[UpdateServerStatus]}" Command="{Binding UpdateServerStatusCommand}" />
                                        <Button Content="{Binding Texts[StartChatLogAuto]}" Command="{Binding StartChatLogForwarderCommand}" />
                                        <Button Content="{Binding Texts[StopChatLogAuto]}" Command="{Binding StopChatLogForwarderCommand}" />
                                        <Button Content="{Binding Texts[SendChatLogEmbedsNow]}" Command="{Binding ScanChatLogCommand}" />
                                        <Button Content="{Binding Texts[SaveSettings]}" Command="{Binding SaveSettingsCommand}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Texts[ChatlogForwarderActive], StringFormat={}{0}: }" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding ChatLogForwarderRunning}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Discord Token" Foreground="{StaticResource MutedTextBrush}" />
                                    <PasswordBox x:Name="DiscordTokenBox" PasswordChanged="DiscordTokenBox_PasswordChanged" />
                                    <Separator Margin="0,14,0,10" />
                                    <CheckBox Content="{Binding Texts[UseSeparateDiscordStatusBot]}" IsChecked="{Binding Settings.UseSeparateDiscordStatusBot}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Texts[SeparateDiscordStatusBotHint]}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                    <TextBlock Text="{Binding Texts[DiscordStatusBotToken]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <PasswordBox x:Name="DiscordStatusTokenBox" PasswordChanged="DiscordStatusTokenBox_PasswordChanged" />
                                    <TextBlock Text="{Binding DiscordStatusBotStatus, StringFormat={}Status-Bot: {0}}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,10" />
                                    <TextBlock Text="Chatlog Embed Channel-ID" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.DiscordChatLogChannelId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Discord -&gt; Game Bridge Channel-ID" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.DiscordGameBridgeChannelId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[ServerStatusChannelId]}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding Settings.DiscordServerStatusChannelId, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{Binding Texts[ServerStatusAutoUpdate]}" IsChecked="{Binding Settings.AutoStartDiscordServerStatusMessage}" Foreground="{StaticResource AppTextBrush}" Margin="0,4,0,4" />
                                    <CheckBox Content="{Binding Texts[DiscordBotStatusUpdate]}" IsChecked="{Binding Settings.AutoStartDiscordBotStatus}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Botstatus Template" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.DiscordBotStatusTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[ServerStatusTitle]}" Foreground="{StaticResource MutedTextBrush}" />
