                                                                Focusable="True"
                                                                Background="#09090D"
                                                                MouseWheel="ScriptMapViewport_MouseWheel"
                                                                MouseLeftButtonDown="ScriptMapViewport_MouseLeftButtonDown"
                                                                MouseMove="ScriptMapViewport_MouseMove"
                                                                MouseLeftButtonUp="ScriptMapViewport_MouseLeftButtonUp"
                                                                MouseLeave="ScriptMapViewport_MouseLeave">
                                                            <Canvas x:Name="ScriptMapContent">
                                                                <Image x:Name="ScriptMapImage" Stretch="Fill" SnapsToDevicePixels="True" />
                                                                <Canvas x:Name="ScriptMapOverlay" IsHitTestVisible="False" />
                                                            </Canvas>
                                                        </Canvas>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding Texts[DebugLogs]}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Texts[DebugLogs]}" FontSize="34" FontWeight="Bold" />
                                <TextBlock Text="{Binding Texts[DebugDescription]}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <TextBlock Text="{Binding Texts[LogFile]}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Text="{Binding LogFilePath, Mode=OneWay}" IsReadOnly="True" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{Binding Texts[OpenLogFolder]}" Command="{Binding OpenLogFolderCommand}" />
                                    <Button Content="{Binding Texts[ClearLogDisplayAndFile]}" Command="{Binding ClearLogCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Texts[LiveLog]}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ListBox ItemsSource="{Binding LogLines}" Background="#0D0D12" Foreground="{StaticResource AppTextBrush}" BorderBrush="{StaticResource AppBorderBrush}" FontFamily="Consolas" FontSize="13" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding Texts[Settings]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts[Settings]}" FontSize="34" FontWeight="Bold" Margin="0,0,0,18" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="RCON" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Host" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.Host, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Port" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[Password]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <PasswordBox x:Name="RconPasswordBox" PasswordChanged="RconPasswordBox_PasswordChanged" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[ShopOrders]}" FontSize="20" FontWeight="SemiBold" />
                                    <CheckBox Content="{Binding Texts[ShopOrdersEnabled]}" IsChecked="{Binding Settings.ShopOrdersEnabled}" Margin="0,8,0,4" />
                                    <TextBlock Text="{Binding Texts[ShopOrdersDescription]}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Texts[ShopWorkerEndpoint]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.ShopWorkerApiEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[ShopWorkerToken]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <PasswordBox x:Name="ShopWorkerApiTokenBox" PasswordChanged="ShopWorkerApiTokenBox_PasswordChanged" />
                                    <TextBlock Text="{Binding Texts[ShopWorkerExample]}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[GgconHttpApiLogs]}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Texts[GgconSettingsHint]}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <TextBlock Text="{Binding Texts[BaseUrlOptional]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.GgconHttpBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[HttpPortHint]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.GgconHttpPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[HttpPasswordHint]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.GgconHttpPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{Binding Texts[UseGgconHttpLogs]}" IsChecked="{Binding Settings.GgconHttpLogsEnabled}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Texts[LogPollSeconds]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.GgconHttpLogPollSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[InitialBackfillSeconds]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.GgconHttpLogInitialBackfillSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SFTP Logs" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="SFTP Host" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpHost, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="SFTP Port" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="SFTP User" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpUser, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[SftpPassword]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <PasswordBox x:Name="SftpPasswordBox" PasswordChanged="SftpPasswordBox_PasswordChanged" />
                                    <TextBlock Text="Remote Directory" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpRemoteDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Chatlog Pattern" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpChatLogPattern, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Vehicle-Destruction Log Pattern" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpVehicleDestructionLogPattern, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Loginlog Pattern" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.FtpLoginLogPattern, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{Binding Texts[ScriptsAutoStart]}" IsChecked="{Binding Settings.AutoStartScripts}" />
                                    <CheckBox Content="{Binding Texts[ChatlogsAutoStart]}" IsChecked="{Binding Settings.AutoStartDiscordChatLogs}" />
                                    <CheckBox Content="{Binding Texts[DiscordServerStatusAutoUpdate]}" IsChecked="{Binding Settings.AutoStartDiscordServerStatusMessage}" />
                                    <CheckBox Content="{Binding Texts[DiscordBotStatusAutoUpdate]}" IsChecked="{Binding Settings.AutoStartDiscordBotStatus}" />
                                    <CheckBox Content="{Binding Texts[CheckUpdatesOnStart]}" IsChecked="{Binding Settings.AutoCheckForUpdates}" />
                                    <CheckBox Content="{Binding Texts[UsageDirectoryOptIn]}" IsChecked="{Binding Settings.UsageDirectoryEnabled}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Texts[UsageDirectoryDescription]}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <Button Content="{Binding Texts[UsageDirectoryOpenSource]}" Command="{Binding OpenUsageDirectorySourceCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding UsageDirectoryStatus}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Texts[UsageDirectoryApi]}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding Settings.UsageDirectoryEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Update latest.json URL" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                    <TextBox Text="{Binding Settings.UpdateLatestJsonUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{Binding Texts[ChatAutoStart]}" IsChecked="{Binding Settings.AutoStartChatCommands}" />
                                    <CheckBox Content="{Binding Texts[PaidVotes]}" IsChecked="{Binding Settings.PaidVotesEnabled}" />
                                    <TextBlock Text="{Binding Texts[VotePrice]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.VotePrice, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[VoteConfirmationSeconds]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.VoteConfirmationTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[VotePrompt]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.VotePurchasePromptResponse, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Texts[VoteInsufficientFunds]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.VoteInsufficientFundsResponse, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <CheckBox Content="{Binding Texts[JoinAutoStart]}" IsChecked="{Binding Settings.AutoStartJoinCommands}" />
                                    <CheckBox Content="{Binding Texts[WeeklyAutoStart]}" IsChecked="{Binding Settings.AutoStartWeeklyTasks}" />
                                    <TextBlock Text="{Binding Texts[WeeklyDbPath]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.WeeklyTaskDbRemoteFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[WeeklyPollMinutes]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.WeeklyTaskPollMinutes, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Killlog Pattern" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Texts[IngameMessageColor]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Texts[ScriptPollSeconds]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.ScriptPollSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{Binding Texts[StartAfterRestartSchedule]}" IsChecked="{Binding Settings.RandomQuestScheduledMode}" />
                                    <TextBlock Text="{Binding Texts[RandomRestartTimesLocal]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.RandomQuestRestartTimes, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[RandomQuestIntervalMinutes]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.RandomQuestIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Texts[RandomQuestStartDelayMinutes]}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Text="{Binding Settings.RandomQuestStartDelayMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="{Binding Texts[Save]}" Command="{Binding SaveSettingsCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>


            </TabControl>
        </Grid>
    </Grid>
</Window>
