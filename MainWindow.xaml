                                                        <Border Background="#111218" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding DataContext.Texts[RandomizerVariantName], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding DataContext.Texts[ChancePercent], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                        <TextBox Text="{Binding ChancePercent, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding DataContext.Texts[RandomizerPackStatusText], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                        <TextBox Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="3" Content="{Binding DataContext.Texts[Delete], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RemoveSettingRandomizerPackOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Bottom" />
                                                                </Grid>

                                                                <Grid Margin="0,10,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="380" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding DataContext.Texts[RandomizerPackValuesHint], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                                        <Grid Margin="0,0,0,3">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding DataContext.Texts[IniSection], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding DataContext.Texts[IniKey], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding DataContext.Texts[Name], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                            <TextBlock Grid.Column="3" Text="{Binding DataContext.Texts[Value], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" />
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding Values}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                                                                        <TextBox Grid.Column="0" Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,5" />
                                                                                        <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,5" />
                                                                                        <TextBox Grid.Column="2" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,5" />
                                                                                        <TextBox Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,5" />
                                                                                        <Button Grid.Column="4" Content="×" ToolTip="{Binding DataContext.Texts[RandomizerRemoveFromAllVariants], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RemoveSettingRandomizerPackValueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,3,0,5" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Background="#171921" BorderBrush="#8E2334" BorderThickness="1" CornerRadius="7" Padding="12" VerticalAlignment="Top">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers><DataTrigger Binding="{Binding HasPuppetSpawnSettings}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DataContext.Texts[PuppetSpawnPreview], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                                            <TextBlock Text="{Binding PuppetSpawnPreview}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </TabControl.ContentTemplate>
                                            </TabControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Texts[VehicleInsurance]}">
                    <views:VehicleInsuranceView />
                </TabItem>
                <TabItem Header="{Binding Texts[Economy]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts[Economy]}" FontSize="34" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Texts[EconomyDescription]}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="16" TextWrapping="Wrap" Margin="0,0,0,18" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[EconomyControls]}" FontSize="20" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,10,0,6">
                                        <Button Content="{Binding Texts[EconomyStart]}" Command="{Binding StartEconomyCommand}" />
                                        <Button Content="{Binding Texts[EconomyStop]}" Command="{Binding StopEconomyCommand}" />
                                        <Button Content="{Binding Texts[EconomyPreview]}" Command="{Binding PreviewEconomyCommand}" IsEnabled="{Binding EconomyActionsEnabled}" />
                                        <Button Content="{Binding Texts[EconomyUpload]}" Command="{Binding UploadEconomyCommand}" IsEnabled="{Binding EconomyActionsEnabled}" />
                                        <Button Content="{Binding Texts[EconomyOpenPreview]}" Command="{Binding OpenEconomyPreviewCommand}" />
                                        <Button Content="{Binding Texts[EconomyPublishWebsite]}" Command="{Binding PublishEconomyWebsiteCommand}" IsEnabled="{Binding EconomyActionsEnabled}" />
                                        <Button Content="{Binding Texts[Save]}" Command="{Binding SaveSettingsCommand}" />
