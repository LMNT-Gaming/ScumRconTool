                                    <TextBlock Text="{Binding EconomySummary}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Texts[EconomyOverridePath]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyOverrideRemoteFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Texts[EconomyLogsPath]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyLogsRemoteDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Texts[EconomyLogPattern]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyLogPattern, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Texts[EconomyPollMinutes]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyPollMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Texts[EconomyRecovery]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyRecoveryHalfLifeHours, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Texts[EconomyPurchaseImpact]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyPurchaseImpactPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Texts[EconomySaleImpact]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomySaleImpactPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{Binding Texts[EconomyMaxBuy]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyMaximumPurchaseMultiplier, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Texts[EconomyMinSell]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyMinimumSellPrice, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Texts[EconomyUploadTimes]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyUploadTimes, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <CheckBox Content="{Binding Texts[EconomyAutoStart]}" IsChecked="{Binding Settings.AutoStartEconomy}" />
                                            <CheckBox Content="{Binding Texts[EconomyAutoUpload]}" IsChecked="{Binding Settings.EconomyAutoUpload}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Texts[EconomyRestartWarning]}" Foreground="#F0B44D"
                                               TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[EconomyWebApi]}" FontSize="20" FontWeight="SemiBold" />
                                    <CheckBox Content="{Binding Texts[EconomyWebApiEnabled]}"
                                              IsChecked="{Binding Settings.EconomyWebApiEnabled}"
                                              Margin="0,10,0,4" />
                                    <TextBlock Text="{Binding Texts[EconomyWebApiDescription]}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Texts[EconomyWebApiEndpoint]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Settings.EconomyWebApiEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Texts[EconomyWebApiToken]}" Foreground="{StaticResource MutedTextBrush}" />
                                            <PasswordBox x:Name="EconomyWebApiTokenBox"
                                                         PasswordChanged="EconomyWebApiTokenBox_PasswordChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Texts[EconomyWebApiExample]}"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[EconomyAffectedItems]}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <DataGrid ItemsSource="{Binding EconomyChanges}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              MaxHeight="470"
                                              Background="#101016"
                                              Foreground="{StaticResource AppTextBrush}"
                                              BorderBrush="{StaticResource AppBorderBrush}"
                                              BorderThickness="1"
                                              RowBackground="#101016"
                                              AlternatingRowBackground="#15151B"
                                              AlternationCount="2"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#29262F"
                                              VerticalGridLinesBrush="Transparent"
                                              RowHeaderWidth="0"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True">
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#651421" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#43111A" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F4F4F6" />

                                            <ControlTemplate x:Key="EconomyScrollPageButton" TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>

                                            <Style x:Key="EconomyScrollThumb" TargetType="{x:Type Thumb}">
                                                <Setter Property="Background" Value="#4B4652" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Border x:Name="ThumbBody"
                                                                    Margin="3,2"
                                                                    MinWidth="6"
                                                                    MinHeight="24"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <Style x:Key="EconomyHorizontalScrollThumb" TargetType="{x:Type Thumb}">
                                                <Setter Property="Background" Value="#4B4652" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Border x:Name="ThumbBody"
                                                                    Margin="2,3"
                                                                    MinWidth="24"
                                                                    MinHeight="6"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <ControlTemplate x:Key="EconomyVerticalScrollBar" TargetType="{x:Type ScrollBar}">
                                                <Border Background="#0C0C11" CornerRadius="6">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                          Template="{StaticResource EconomyScrollPageButton}" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource EconomyScrollThumb}" />
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                          Template="{StaticResource EconomyScrollPageButton}" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Border>
                                            </ControlTemplate>

                                            <ControlTemplate x:Key="EconomyHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
                                                <Border Background="#0C0C11" CornerRadius="6">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                                          Template="{StaticResource EconomyScrollPageButton}" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource EconomyScrollThumb}" />
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                                          Template="{StaticResource EconomyScrollPageButton}" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Border>
                                            </ControlTemplate>

                                            <Style TargetType="{x:Type ScrollBar}">
                                                <Setter Property="Background" Value="#0C0C11" />
                                                <Setter Property="Width" Value="13" />
                                                <Setter Property="Template" Value="{StaticResource EconomyVerticalScrollBar}" />
                                                <Style.Triggers>
                                                    <Trigger Property="Orientation" Value="Horizontal">
                                                        <Setter Property="Width" Value="Auto" />
                                                        <Setter Property="Height" Value="13" />
                                                        <Setter Property="Template" Value="{StaticResource EconomyHorizontalScrollBar}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="Background" Value="#1E1E27" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="Padding" Value="10,9" />
                                                <Setter Property="MinHeight" Value="38" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>

                                            <Style TargetType="{x:Type DataGridRow}">
                                                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="MinHeight" Value="30" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#21171C" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#651421" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <Style TargetType="{x:Type DataGridCell}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="9,5" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Trader}" Width="150">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomyTrader], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding TraderRole}" Width="110">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomyTraderType], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Item}" Width="*">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomyItem], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Transactions}" Width="75">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomyTrades], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding ChangeDisplay}" Width="90">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomyPressure], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding PurchaseDisplay}" Width="150">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomyBuyPrice], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding SellDisplay}" Width="150">
                                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Texts[EconomySellPrice], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Texts[GlobalLootPacks]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{Binding Texts[AddLootPack]}" Command="{Binding AddGlobalLootPackCommand}" />
                                <Button Content="{Binding Texts[Save]}" Command="{Binding SaveGlobalLootPacksCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding GlobalLootPacksView}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,14,0,10" Padding="12,8" CornerRadius="8" Background="#181820" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Name}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Weapons"><Setter Property="Text" Value="{Binding DataContext.Texts[LootPackCategoryWeapons], RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Ammunition"><Setter Property="Text" Value="{Binding DataContext.Texts[LootPackCategoryAmmunition], RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Equipment"><Setter Property="Text" Value="{Binding DataContext.Texts[LootPackCategoryEquipment], RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Consumables"><Setter Property="Text" Value="{Binding DataContext.Texts[LootPackCategoryConsumables], RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Mixed"><Setter Property="Text" Value="{Binding DataContext.Texts[LootPackCategoryMixed], RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
