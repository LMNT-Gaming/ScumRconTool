# Diese Datei auf dem Windows-Server als .env neben gym-sync-windows.js ablegen.

# ggCON HTTP API auf deinem Gameserver / Windows-Server
GGCON_BASE_URL=http://127.0.0.1:8081
GGCON_PASSWORD=dein_ggcon_passwort

# Strato-Webseite, passend zu deinem /scum/-Pfad
GYM_PUSH_URL=https://deine-domain.de/scum/api/gym_push.php
GYM_PUSH_TOKEN=bitte_einen_langen_zufaelligen_token_setzen

# Optional: 15 Minuten
GYM_SYNC_INTERVAL_MS=900000
