# ggCON HTTP API fuer GYM Sync
# Beispiel: http://127.0.0.1:8081 oder http://DEINE-SERVER-IP:8081
GGCON_BASE_URL=http://127.0.0.1:8081
GGCON_PASSWORD=dein_ggcon_passwort

# Optional. Default: private/gym_data
GYM_DATA_DIR=/root/scum/private/gym_data

# Optional. Nur Snapshots speichern, wenn sich Werte wirklich veraendert haben.
GYM_SAVE_UNCHANGED=0
